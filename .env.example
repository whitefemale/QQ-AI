# AI 群友本地环境配置示例。
# 复制为 .env 后按需修改：backend\.venv\Scripts\python.exe scripts\gen_keys.py --write
# 不要提交真实 .env、QQ 凭证、API Key 或 OneBot Token。
#
# Windows 安装版不会读取本文件：它在 %APPDATA%\ai-group-friend-desktop\.env
# 自动生成独立密钥与配置。以下内部变量由桌面壳固定注入，不建议手工设置：
#   AI_GROUP_FRIEND_ENV_FILE / AI_GROUP_FRIEND_RESOURCE_ROOT / AI_GROUP_FRIEND_INSTALLER_EXE

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=Asia/Shanghai

# 数据目录默认 <项目根>/data；数据库默认 <data_dir>/ai_group_friend.db。
# 只有需要自定义时才取消注释。相对 DATABASE_URL 按后端启动工作目录解析。
# DATA_DIR=
# DATABASE_URL=sqlite+aiosqlite:///../data/ai_group_friend.db
AUTO_MIGRATE=true

# 本地密钥：必须由 gen_keys.py 生成，不要手工使用弱口令。
# CREDENTIAL_ENCRYPTION_KEY 丢失后，已保存的 Token / API Key 将无法解密。
APP_SECRET_KEY=replace-with-random-local-secret
CREDENTIAL_ENCRYPTION_KEY=replace-with-generated-fernet-key

# 管理接口安全：默认只允许本机访问。
# 远程管理需同时设置 ALLOW_REMOTE_ADMIN=true 和强随机 ADMIN_API_TOKEN，
# 并置于 HTTPS 反向代理/额外访问控制之后。本机请求不校验该 Token。
ALLOW_REMOTE_ADMIN=false
ADMIN_API_TOKEN=

# 允许的 Host 头（逗号分隔）。默认始终允许本机地址；远程管理或反向代理
# 部署时必须显式加入代理域名，否则返回 400 Invalid host header。
# 仅设置 * 会关闭 Host 校验，只应在完全受控的本机环境使用。
# ALLOWED_HOSTS=example.internal

# 可选：仅用于临时调试。正式使用请在控制台「模型 API」中填写，
# 数据库只保存 Fernet 密文；环境变量中的 Key 是明文。
# DEFAULT_LLM_PROVIDER=openai_compatible
# DEFAULT_LLM_BASE_URL=
# DEFAULT_LLM_MODEL=
# DEFAULT_LLM_API_KEY=

# 运行参数（可选）
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=45
# 单进程 Provider 保护（不是分布式限流）；Mock 不受限。
LLM_MAX_CONCURRENCY_PER_PROVIDER=2
LLM_MIN_INTERVAL_MS=200
LLM_MODEL_LIST_TIMEOUT_SECONDS=20
LLM_RETRY_BASE_SECONDS=0.5
LLM_RETRY_MAX_SECONDS=8
LLM_RETRY_JITTER_SECONDS=0.25
LLM_RETRY_AFTER_MAX_SECONDS=30
# 读/写超时可能已经被服务商计费；默认不自动重试，避免重复费用。
LLM_RETRY_AMBIGUOUS_TIMEOUTS=false
MAX_TOOL_ROUNDS=2
MAX_TOOL_CALLS_PER_TURN=3
MAX_MEDIA_BYTES=10485760
OUTBOX_MAX_ATTEMPTS=3
OUTBOX_FAILURE_PAUSE_THRESHOLD=3
CONTEXT_MESSAGE_LIMIT=20
MAX_REPLY_CHARS=500

# 长期记忆注入上限（按条数与字符预算双重裁剪）
MEMORY_MAX_ITEMS=6
MEMORY_MAX_CHARS=1600

# AI 记忆提取：手动或群级后台增量触发，结果必须人工审核后才会进入正式记忆。
# 后台提取默认在群内关闭；此间隔只控制调度器检查频率（秒）。
MEMORY_EXTRACTION_MAX_MESSAGES=40
MEMORY_EXTRACTION_MAX_CANDIDATES=6
MEMORY_EXTRACTION_MIN_CONFIDENCE=0.6
MEMORY_AUTO_EXTRACTION_INTERVAL_SECONDS=300

# 默认保留天数；自动清理默认关闭，可在控制台手动执行或显式开启。
LOG_RETENTION_DAYS=30
MESSAGE_RETENTION_DAYS=90
MEDIA_RETENTION_DAYS=30

# 生产前端目录（默认 <项目根>/frontend/dist）
# FRONTEND_DIST=

# 受管连接器根目录（默认 <项目根>/connectors/napcat）。
# 连接器 API 不接受任意路径；桌面版通过系统目录选择写入此值并重启后端。
# CONNECTORS_DIR=

# 前端开发地址（CORS 白名单，逗号分隔，必须带 scheme，不接受 *）。
# 启动时校验；格式不合法的来源会让后端直接启动失败，而不是静默放行。
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
